// Prisma Schema for Movie Room App
// 注意：SQLite 不支持 enum，使用 String 代替
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  nickname      String    @unique
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 用户名修改冷却（30 天）
  usernameChangedAt DateTime?

  // 封禁相关
  banned        Boolean   @default(false)
  banReason     String?
  bannedAt      DateTime?
  lastIp        String?
  abruptLeaves  Int       @default(0) // 放映中强行中断次数（≥3 永久封禁）

  // 管理员
  isAdmin       Boolean   @default(false)

  // JWT 令牌版本：改密/封禁时自增，使此前签发的 JWT 立即失效
  tokenVersion  Int       @default(0)

  // 每 IP 地址允许同时开设的房间数上限（0 = 禁止开房，但不影响加入他人房间）。
  // 管理员可在后台逐个用户调整，取值 0–20。
  maxRoomsPerIp   Int       @default(1)

  rooms         Room[]   @relation("HostedRooms")
  memberships   RoomMember[]
  bans          RoomBan[]
  @@map("users")
}

model Room {
  id              String    @id @default(uuid())
  name            String
  description     String?
  images          String?         // 房间图片（JSON 数组，最多 5 张）
  hostId          String
  host            User      @relation("HostedRooms", fields: [hostId], references: [id])
  // 创建房间那一刻房主的 IP，用于「每个 IP 每名用户同时可开设房间数」的限制。
  // 历史房间（本字段上线前创建的）为 null，统计限额时只计非 null 的数据，
  // 以免老房间挤占新配额。
  hostIp          String?

  // 房间设置
  password        String?         // 密码保护（可选）
  maxViewers      Int             @default(30) // 最大观众数

  // 房间状态：WAITING, PLAYING, ENDED
  status          String          @default("WAITING")
  currentMovie    String?         // 当前播放的电影名（仅作显示）

  // ===== 【需求1】播放源持久化 =====
  // 背景：播放源此前只活在服务器内存（roomPlaybackStates），因此服务重启、
  // 房主刷新页面（房间内连接数瞬间归零）、房主短暂断线超过宽限期都会把直链弄丢，
  // 表现为「房间还在、但新观众拿不到播放地址」。
  // 这里把播放源落库，内存仅作缓存；内存未命中时回落到数据库。
  // sourceUrl 为 null 表示当前房间没有播放源（未开始播放，或房主已「结束放映」）。
  sourceUrl        String?
  sourceIsHls      Boolean         @default(false)
  sourceResolution String?
  sourceUpdatedAt  DateTime?
  // 最近一次同步的播放位置（毫秒）。由 sync-progress（节流）与 host-seek 写入，
  // 用于服务重启 / 内存丢失后，新观众仍能续播到接近的位置，而不是从 0 开始。
  lastPositionMs   Int             @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         RoomMember[]
  bans            RoomBan[]
  @@map("rooms")
}

model RoomMember {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  // 角色：HOST, VIEWER
  role        String    @default("VIEWER")
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  @@unique([roomId, userId])
  @@map("room_members")
}

// 房间黑名单（被房主踢出的用户，5 小时内禁止再次进入；房间解散时清除）
model RoomBan {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([roomId, userId])
  @@map("room_bans")
}

// 全局 IP 封禁列表（永久封禁的用户 IP，管理员可解除）
model BannedIp {
  id          String    @id @default(uuid())
  ip          String    @unique
  reason      String?
  userId      String?   // 关联被封禁的用户
  createdAt   DateTime  @default(now())

  @@map("banned_ips")
}

// 已消费的邮箱验证令牌 jti（一次性令牌落库，防重放）
// 注意：仅存内存会在服务重启后使全部已消费令牌复活，故必须持久化。
model UsedToken {
  jti       String   @id
  usedAt    DateTime @default(now())

  @@map("used_tokens")
}

// 邮箱验证完成记录：用户点击邮件验证链接、服务端确认 token 有效的那一刻写入。
// 用途：注册/改密/绑邮箱时，即使前端本地暂存的 token 丢失（换标签页/换设备/刷新），
// 服务端也能按「邮箱 + 用途」独立判断该邮箱是否已完成验证，从而实现兜底求证。
model EmailVerify {
  id        String   @id @default(uuid())
  email     String
  purpose   String   // register | change-password | bind-email
  verifiedAt DateTime @default(now())

  @@unique([email, purpose])
  @@map("email_verifies")
}

// ===== 【需求4A】管理员广播 =====
// 一条循环滚动的弹幕，仅出现在观影房间页（导航栏下方的全宽横条）。
// 生命周期为「永久」——发布后持续滚动，直到管理员在后台手动停播，不自动过期。
// 同一时间只有最新发布且 active 的一条生效（发布新的即自动停用旧的）。
model Broadcast {
  id        String    @id @default(uuid())
  content   String                // 广播内容（弹幕文字）
  color     String    @default("#ffffff") // 文字颜色
  speed     Int       @default(3) // 快慢档位 1~5，与视频弹幕同口径
  active    Boolean   @default(true)
  createdBy String?               // 发布管理员 userId
  createdAt DateTime  @default(now())
  stoppedAt DateTime?             // 停播时间

  @@map("broadcasts")
}

// ===== 【需求4B】管理员公告 =====
// 首屏弹窗形式下发，按登录用户维度「仅显示一次」（见 AnnouncementRead）。
model Announcement {
  id        String    @id @default(uuid())
  title     String?
  content   String
  createdBy String?               // 发布管理员 userId
  createdAt DateTime  @default(now())

  reads     AnnouncementRead[]

  @@map("announcements")
}

// 公告已读记录：每条公告 + 每个用户唯一。
// 未写入即代表该用户尚未看过这条公告（下次访问时仍会弹出）。
model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}
