// Prisma Schema for Movie Room App
// 注意：SQLite 不支持 enum，使用 String 代替
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  nickname      String    @unique
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 用户名修改冷却（30 天）
  usernameChangedAt DateTime?

  // 封禁相关
  banned        Boolean   @default(false)
  banReason     String?
  bannedAt      DateTime?
  lastIp        String?
  abruptLeaves  Int       @default(0) // 放映中强行中断次数（≥3 永久封禁）

  // 管理员
  isAdmin       Boolean   @default(false)

  // JWT 令牌版本：改密/封禁时自增，使此前签发的 JWT 立即失效
  tokenVersion  Int       @default(0)

  // 每 IP 地址允许同时开设的房间数上限（0 = 禁止开房，但不影响加入他人房间）。
  // 管理员可在后台逐个用户调整，取值 0–20。
  maxRoomsPerIp   Int       @default(1)

  rooms         Room[]   @relation("HostedRooms")
  memberships   RoomMember[]
  bans          RoomBan[]
  screeningAs   RoomScreeningHost[]
  @@map("users")
}

/// 【BUG-01 修复】服务实例心跳表。
///
/// 解决什么问题：进程启动时会「回收上次残留的房间成员行」，原本是无条件
/// roomMember.deleteMany({})。单实例下重启后内存映射确实是权威空态，清空是对的；
/// 但一旦跑多个副本，某个副本启动就会把**仍在其他副本上看电影的人**从名单里删掉 ——
/// 大厅人数变少、名额被凭空释放。
///
/// 「是否有别的副本在跑」这个信息必须跨进程且跨重启可得（重启后正是要判断它），
/// 进程内变量不够用，因此落一张极小的表：每个进程启动时插入一行并周期性更新
/// heartbeatAt；判断「是否有别的活跃实例」就是看有没有 heartbeatAt 足够新的其他行。
model ServiceInstance {
  id          String   @id
  bootedAt    DateTime @default(now())
  heartbeatAt DateTime @default(now())

  @@map("service_instances")
}

model Room {
  id              String    @id @default(uuid())
  name            String
  description     String?
  images          String?         // 房间图片（JSON 数组，最多 5 张）
  hostId          String
  host            User      @relation("HostedRooms", fields: [hostId], references: [id])
  // 创建房间那一刻房主的 IP，用于「每个 IP 每名用户同时可开设房间数」的限制。
  // 历史房间（本字段上线前创建的）为 null，统计限额时只计非 null 的数据，
  // 以免老房间挤占新配额。
  hostIp          String?

  /// 房间类型：**创建时定型**，之后不再根据创建者身份重新推导。
  ///   NORMAL —— 普通用户创建。房主最后一个连接断开 20 秒后立即解散并彻底清除。
  ///   PUBLIC —— 管理员创建。永不解散，只能由管理员在后台删除，额外带「放映通道」。
  /// 之所以存显式字段：用 host.isAdmin 现场推导会让「把某人升为管理员」把他已有的
  /// 普通房间瞬间变成公共房间（永不解散），反之亦然。类型一旦定型就不该再变。
  kind            String          @default("NORMAL")

  // 房间设置
  password        String?         // 密码保护（可选，可重复使用）
  maxViewers      Int             @default(30) // 最大观众数

  // ===== 【公共房间】放映通道（一次性密码 + 放映人白名单）=====
  //
  // 管理员账号创建的房间即「公共房间」。它与普通房间的差别：
  //   1) 大厅里永远置顶，创建人显示为「公共放映厅」，带淡紫描边；
  //   2) 只能由管理员在后台解散，房间内无人也不会自动消失；
  //   3) 额外提供一条「放映通道」，通过它进入的人获得放映权限（≈房主权限，但不可解散）。
  //
  // screeningPassword：放映通道密码。**一次性**——第一个非管理员用户用它进入后立即置 null。
  // screeningUpdatedAt：放映密码的最近变更时间，仅用于后台展示。
  // 字段命名刻意与 password 区分：房间普通密码与放映密码互不冲突、互不影响。
  screeningPassword    String?
  screeningUpdatedAt   DateTime?
  /// 【公共房间】本场放映期间，房间信息最后一次被放映人修改的时间。
  /// 与放映人记录的 claimedAt 比较即可判断「当前这位放映人本场是否已经改过」——
  /// 改过就跳过信息编辑弹窗（需求：每人每场电影只能改一次，改过之后再进来自动跳过）。
  /// 不需要额外的布尔字段：本场开始时由 releaseScreening 一并清空，天然复位。
  roomEditedAt         DateTime?

  // 房间状态：WAITING, PLAYING, ENDED
  status          String          @default("WAITING")
  currentMovie    String?         // 当前播放的电影名（仅作显示）

  // ===== 【需求1】播放源持久化 =====
  // 背景：播放源此前只活在服务器内存（roomPlaybackStates），因此服务重启、
  // 房主刷新页面（房间内连接数瞬间归零）、房主短暂断线超过宽限期都会把直链弄丢，
  // 表现为「房间还在、但新观众拿不到播放地址」。
  // 这里把播放源落库，内存仅作缓存；内存未命中时回落到数据库。
  // sourceUrl 为 null 表示当前房间没有播放源（未开始播放，或房主已「结束放映」）。
  sourceUrl        String?
  sourceIsHls      Boolean         @default(false)
  sourceResolution String?
  sourceUpdatedAt  DateTime?
  // 最近一次同步的播放位置（毫秒）。由 sync-progress（节流）与 host-seek 写入，
  // 用于服务重启 / 内存丢失后，新观众仍能续播到接近的位置，而不是从 0 开始。
  lastPositionMs   Int             @default(0)

  // ===== 【循环播放】仅管理员创建的房间（kind = PUBLIC）使用 =====
  // 开启后，当前视频播完不结束本场放映，而是自动回到 0:00 重播，观众同步。
  // 只有房间创建者本人能切换；开关落库，只要房间没被解散就一直记住。
  loopPlayback     Boolean         @default(false)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         RoomMember[]
  bans            RoomBan[]
  screeningHosts  RoomScreeningHost[]
  @@map("rooms")
}

/// 公共房间的「放映人」记录（当前谁通过放映通道拿到了放映权限）。
///
/// 设计要点：
///  - 每房间最多一条（roomId 唯一）：放映权限是排他的，同一时间只有一个人是放映人。
///  - 掉线不立即删除，而是写入 graceUntil = now + 3 分钟：放映人刷新页面/网络抖动后
///    仍能在宽限期内重新连回来继续放映（否则刷新一次就要管理员重设密码，体验太差）。
///  - graceUntil 过期后由服务端清理，并把 screeningPassword 置 null、房间回到 WAITING，
///    即「通道回到未设密码状态」，需要管理员重新设密码。
model RoomScreeningHost {
  id         String    @id @default(uuid())
  roomId     String    @unique
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  claimedAt  DateTime  @default(now())
  /// 宽限截止时间。为 null 表示该放映人当前在线（连接正常）。
  graceUntil DateTime?
  @@map("room_screening_hosts")
}

model RoomMember {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  // 角色：HOST, VIEWER
  role        String    @default("VIEWER")
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  @@unique([roomId, userId])
  @@map("room_members")
}

// 房间黑名单（被房主踢出的用户，5 小时内禁止再次进入；房间解散时清除）
model RoomBan {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([roomId, userId])
  @@map("room_bans")
}

// 全局 IP 封禁列表（永久封禁的用户 IP，管理员可解除）
model BannedIp {
  id          String    @id @default(uuid())
  ip          String    @unique
  reason      String?
  userId      String?   // 关联被封禁的用户
  createdAt   DateTime  @default(now())

  @@map("banned_ips")
}

// 已消费的邮箱验证令牌 jti（一次性令牌落库，防重放）
// 注意：仅存内存会在服务重启后使全部已消费令牌复活，故必须持久化。
model UsedToken {
  jti       String   @id
  usedAt    DateTime @default(now())

  @@map("used_tokens")
}

// 邮箱验证完成记录：用户点击邮件验证链接、服务端确认 token 有效的那一刻写入。
// 用途：注册/改密/绑邮箱时，即使前端本地暂存的 token 丢失（换标签页/换设备/刷新），
// 服务端也能按「邮箱 + 用途」独立判断该邮箱是否已完成验证，从而实现兜底求证。
model EmailVerify {
  id        String   @id @default(uuid())
  email     String
  purpose   String   // register | change-password | bind-email
  verifiedAt DateTime @default(now())

  @@unique([email, purpose])
  @@map("email_verifies")
}

// ===== 【需求4A】管理员广播 =====
// 一条循环滚动的弹幕，仅出现在观影房间页（导航栏下方的全宽横条）。
// 生命周期为「永久」——发布后持续滚动，直到管理员在后台手动停播，不自动过期。
// 同一时间只有最新发布且 active 的一条生效（发布新的即自动停用旧的）。
model Broadcast {
  id        String    @id @default(uuid())
  content   String                // 广播内容（弹幕文字）
  color     String    @default("#ffffff") // 文字颜色
  speed     Int       @default(3) // 快慢档位 1~5，与视频弹幕同口径
  active    Boolean   @default(true)
  createdBy String?               // 发布管理员 userId
  createdAt DateTime  @default(now())
  stoppedAt DateTime?             // 停播时间

  @@map("broadcasts")
}

// ===== 【需求4B】管理员公告 =====
// 首屏弹窗形式下发，按登录用户维度「仅显示一次」（见 AnnouncementRead）。
model Announcement {
  id        String    @id @default(uuid())
  title     String?
  content   String
  createdBy String?               // 发布管理员 userId
  createdAt DateTime  @default(now())

  reads     AnnouncementRead[]

  @@map("announcements")
}

// 公告已读记录：每条公告 + 每个用户唯一。
// 未写入即代表该用户尚未看过这条公告（下次访问时仍会弹出）。
model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}
