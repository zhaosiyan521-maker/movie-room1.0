# 数据库
DATABASE_URL="file:./dev.db"

# JWT 密钥（必填，至少 32 位随机字符）
# 生成方式：openssl rand -hex 32
# 注意：此处必须留空。一键启动脚本会自动生成随机密钥写入 .env。
# 若在此处填入固定值并提交到仓库，所有使用该默认值的新装实例将共用同一密钥，
# 攻击者可自行签发任意用户的 JWT 冒充管理员（含本仓库曾出现过的历史示例值）。
JWT_SECRET=""

# 服务器端口
PORT=3001

# 服务监听地址：默认仅本机回环，避免暴露到局域网/公网。
# 如需让同一局域网的设备加入观影，改为 0.0.0.0，并把 CLIENT_URL 设为对应地址。
HOST="127.0.0.1"

# 前端地址（用于 CORS 白名单），多个来源用英文逗号分隔
# 开发模式前端跑在 5173；生产模式由后端同源托管前端（3001），两个都要加入白名单
CLIENT_URL="http://localhost:5173,http://localhost:3001,http://127.0.0.1:3001"

# 对外公开的站点地址（用于拼接邮箱验证链接等发给用户的 URL）。
# 可选：不填则自动取 CLIENT_URL 的第一个值。
# 建议显式填写，与 CORS 白名单彻底解耦——将来换域名/改端口时只改这里，
# 不用动 CLIENT_URL 的顺序，邮箱链接就不会坏。
# 例：PUBLIC_URL="https://movie.example.com" 或 "http://121.43.63.229:3001"
PUBLIC_URL=""

# 邮件 SMTP 配置（留空则仅在服务端控制台打印验证链接，便于本地联调）
# 填写后系统会通过该邮箱发送“验证链接”邮件
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
