# Dependencies
node_modules/
.pnp
.pnp.js

# lock 文件不入库：开发在 Windows、部署在 Linux，npm 只会把「当前平台」的原生
# 可选依赖写进 lock，跨平台会导致 @rollup/rollup-linux-x64-gnu / @esbuild/linux-x64
# 等条目缺失，服务器 build 直接崩溃（npm/cli#4828）。各环境自行 npm install 生成。
package-lock.json

# Build outputs
dist/
release/
out/

# Environment files
.env
.env.local
.env.production

# Database
*.db
*.db-journal

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Certificates (微信支付证书)
certs/
*.pem

# 运行时上传的房间图片（用户数据，不入库）
uploads/

# TypeScript 增量编译缓存
*.tsbuildinfo

# WorkBuddy 工作区记忆（本机笔记，不入库）
.workbuddy/

# 代码审计报告（含漏洞细节，暂不入库）
代码审计报告.md

# 本地临时目录（浏览器配置缓存 / 临时数据库等，体量大且与本项目无关）
.tmp-*/
.tmp-chrome/
.tmp-src/

# 部署同步用的 SSH 私钥与 known_hosts（绝不能入库）
dsh-sync-key
dsh-sync-key.pub
dsh-known-hosts
dsh-payload.b64
# GitHub 推送专用密钥（同样绝不能入库）
dsh-github-key
dsh-github-key.pub
dsh-github-known-hosts
