{
  "name": "movie-room-app",
  "version": "1.0.0",
  "description": "共享观影室 - 最多30人同时在线观看电影",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:server && npm run build:client",
    "db:push": "npm run prisma:push --workspace=server",
    "db:generate": "npm run prisma:generate --workspace=server",
    "start": "npm run start --workspace=server",
    "start:web": "npm run build && npm run start",
    "verify:security": "node scripts/verify-security.js",
    "verify:e2e": "node scripts/verify-e2e.js",
    "verify:socket": "node scripts/verify-socket.js",
    "verify": "npm run verify:security && npm run verify:e2e && npm run verify:socket"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
